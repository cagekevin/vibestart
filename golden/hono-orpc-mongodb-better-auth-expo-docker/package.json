{
  "name": "my-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "ready": "vp check && vp run knip && vp test && vp run -r build",
    "prepare": "vp config",
    "db:migrate": "vp run --filter @my-app/server db:migrate",
    "dev:mobile": "vp run --filter @my-app/mobile start",
    "knip": "knip",
    "adr": "node scripts/adr.mjs audit && node scripts/adr.mjs refs --check",
    "arch": "node scripts/arch-index.mjs",
    "debt": "node scripts/debt.mjs audit",
    "scan": "node scripts/scan.mjs"
  },
  "devDependencies": {
    "@my-app/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "oxc-parser": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
